# -----------------------------------------------------------------------------
# MamAmie AI Backend - Environment Configuration Example
# Copy this file to .env and configure values for your environment.
# NEVER commit real production secrets into version control.
# -----------------------------------------------------------------------------

# Application
APP_ENV=development
DEBUG=true
PROJECT_NAME="MamAmie AI Backend"
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# CORS (JSON string array of allowed origins)
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:8000"]'

# Database
# For local dev / test zero-config: sqlite+aiosqlite:///./mamamie.db
# For production PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/mamamie_db
DATABASE_URL=sqlite+aiosqlite:///./mamamie.db
DB_ECHO=false

# Authentication & Security
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_TO_A_CRYPTOGRAPHICALLY_SECURE_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# File Storage (local or s3)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_EXTENSIONS='[".pdf", ".jpg", ".jpeg", ".png", ".heic"]'

# S3 Compatible Storage (optional when STORAGE_PROVIDER=s3)
S3_BUCKET_NAME=mamamie-medical-records
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# AI Provider Configuration (grounded_local, openai, or gemini)
# "grounded_local" uses our deterministic rule-based & approved medical content retrieval engine without external API dependency
AI_PROVIDER=grounded_local
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL_NAME=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=20

# Notifications
NOTIFICATION_PROVIDER=mock
FCM_CREDENTIALS_PATH=

# Rate Limiting
AUTH_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_MINUTE=20
